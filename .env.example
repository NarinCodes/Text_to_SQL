# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Fireworks AI — get a key at https://fireworks.ai (Settings -> API Keys)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Model used for SQL generation (any open-weight model in the Fireworks library).
# Pick a fast model that emits clean SQL to meet the interactive latency target;
# verify current IDs at https://fireworks.ai/models (availability varies by account).
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
